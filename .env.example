API_PORT=9000
SOCKET_PORT=9002
PREVIEW_PORT=8000
PREVIEW_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:9000
NEXT_PUBLIC_SOCKET_URL=http://localhost:9002

